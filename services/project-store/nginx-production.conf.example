# HTTP context. CloudFront appends the actual viewer address last.
map $http_x_forwarded_for $microbit_client_ip {
    ~(?<microbit_last_ip>[^,\s]+)$ $microbit_last_ip;
    default $binary_remote_addr;
}
map $request_method $microbit_prod_write_key {
    default "";
    POST $microbit_client_ip;
}
limit_req_zone $microbit_prod_write_key zone=microbit_prod_save:10m rate=30r/m;

