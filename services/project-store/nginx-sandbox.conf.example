# HTTP-context declarations (e.g. conf.d/00-microbit-save-rate.conf).
map $request_method $microbit_write_key {
    default "";
    POST $binary_remote_addr;
}
limit_req_zone $microbit_write_key zone=microbit_save:1m rate=5r/m;

